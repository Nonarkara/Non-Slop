    "KINETIC-GRIDS-FOR-AI.md",
    "AGENTS.md",
    "CREDITS.md",
    "LICENSE",
    "README.md",
    "bin",
    "lib",
    "skills",
    "templates",
    "install.sh",
    "DECISION-GEOMETRY.md",
    "tools/decision-geometry"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "catalog": "node bin/non-slop.mjs rules --md > skills/detect/CATALOG.md"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
